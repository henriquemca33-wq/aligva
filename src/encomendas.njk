---
layout: layouts/base.njk
title: Encomendas
description: Perfumes fora da Linha Aligva, produzidos sob pedido. Femininos, masculinos e compartilháveis — encomende pelo WhatsApp.
permalink: /encomendas/
eleventyComputed:
  dadosEstruturados:
    - "@context": "https://schema.org"
      "@type": BreadcrumbList
      itemListElement:
        - { "@type": ListItem, position: 1, name: "Início", item: "{{ '/' | absoluta }}" }
        - { "@type": ListItem, position: 2, name: "Encomendas", item: "{{ '/encomendas/' | absoluta }}" }
---
{% from "partes/macros.njk" import icone %}
{% set enc = site.linhas.encomendas %}
<div class="container">
  <header class="cabecalho-pagina">
    <span class="sobrescrito">Sob pedido</span>
    <h1>Encomendas</h1>
    <p>{{ enc.texto }}</p>
  </header>
</div>

<section class="secao secao--papel verge" aria-labelledby="titulo-como-funciona">
  <div class="container duas-colunas">
    <div>
      <h2 id="titulo-como-funciona">Como funciona</h2>
      <p class="texto-suave">As encomendas não ficam na loja online: são produzidas quando você pede.</p>
      {% if enc.prazoProducao %}<p><strong>Prazo de produção:</strong> {{ enc.prazoProducao }}.</p>{% endif %}
    </div>
    <ol class="passos passos--coluna">
      {% for passo in enc.comoFunciona %}<li><p>{{ passo }}</p></li>{% endfor %}
    </ol>
  </div>
</section>

<div class="container secao">
  {% if catalogo.encomendas.length %}
  <nav aria-label="Grupos de encomendas">
    <ul class="indice-grupos">
      {% for grupo in catalogo.encomendas %}<li><a href="#{{ grupo.genero }}">{{ grupo.rotulo }}</a></li>{% endfor %}
    </ul>
  </nav>
  {% for grupo in catalogo.encomendas %}
  <section class="grupo-encomendas" id="{{ grupo.genero }}" aria-labelledby="titulo-{{ grupo.genero }}">
    <h2 id="titulo-{{ grupo.genero }}">{{ grupo.rotulo }}</h2>
    <ul class="lista-encomendas">
      {% for p in grupo.produtos %}
      <li class="encomenda">
        <div>
          <h3><a href="/perfume/{{ p.slug }}/">{{ p.nome }}</a></h3>
          <p class="encomenda__notas">
            {% if p.familiaRotulo %}{{ p.familiaRotulo }}{% if p.todasNotas.length %} · {% endif %}{% endif %}{{ p.todasNotas | join(', ') }}
          </p>
        </div>
        <div class="encomenda__acoes">
          {% set precoTexto = p | precoAPartir %}
          {% if precoTexto %}<span class="encomenda__preco">{{ precoTexto }}</span>{% endif %}
          {% if site.whatsapp.numero %}
          <a class="botao botao--contorno botao--pequeno" href="{{ p.nome | mensagemProduto('encomenda') | whatsapp }}" target="_blank" rel="noopener">{{ icone('conversa') }} Encomendar pelo WhatsApp<span class="visualmente-oculto">: {{ p.nome }}</span></a>
          {% else %}
          <a class="botao botao--contorno botao--pequeno" href="mailto:{{ site.email }}?subject={{ ('Encomenda: ' + p.nome) | urlencode }}">{{ icone('email') }} Encomendar por e-mail<span class="visualmente-oculto">: {{ p.nome }}</span></a>
          {% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}
  {% else %}
  <p>A lista de encomendas será publicada em breve. Enquanto isso, fale com a gente pelo e-mail <a href="mailto:{{ site.email }}">{{ site.email }}</a>.</p>
  {% endif %}
</div>
